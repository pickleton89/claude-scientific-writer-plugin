{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "synthesis.json",
  "title": "DeepResearchSynthesis",
  "description": "Synthesis sidecar emitted by the deep-research synthesis agent at the end of Phase 3. Captures thematic synthesis, gap analysis, contradictions, and (when applicable) hypotheses. Every supporting_paper_ids[] entry must resolve in the referenced sources.json. Validated by skills/deep-research/scripts/validate_sidecar.py + predicates Y1-Y3.",
  "type": "object",
  "required": ["schema_version", "metadata", "themes", "gaps", "contradictions"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "metadata": {
      "type": "object",
      "required": ["frozen_at", "mode", "topic_slug", "sources_sidecar", "grading_sidecar"],
      "properties": {
        "frozen_at": { "type": "string", "format": "date-time" },
        "mode": {
          "type": "string",
          "enum": ["full", "lit-review", "systematic-review", "hypothesis", "fact-check", "review"]
        },
        "topic_slug": { "type": "string", "minLength": 1 },
        "sources_sidecar": { "type": "string", "minLength": 1 },
        "grading_sidecar": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "themes": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/definitions/Theme" }
    },
    "gaps": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/definitions/Gap" }
    },
    "contradictions": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/definitions/Contradiction" }
    },
    "dossier_cross_refs": {
      "type": "array",
      "description": "Optional. Populated when an upstream biomedical dossier is present.",
      "items": { "$ref": "#/definitions/DossierCrossRef" }
    },
    "hypotheses": {
      "type": "array",
      "description": "Required for mode == 'hypothesis'. Empty array otherwise.",
      "items": { "$ref": "#/definitions/Hypothesis" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Theme": {
      "type": "object",
      "required": ["id", "title", "paragraph", "supporting_paper_ids"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T-[0-9]{2}$",
          "description": "Theme ID. Pattern T-NN (e.g. T-01)."
        },
        "title": { "type": "string", "minLength": 1 },
        "paragraph": {
          "type": "string",
          "minLength": 1,
          "description": "Thematic synthesis paragraph. Inline T1-T4 evidence labels per shared/references/evidence_grading.md."
        },
        "supporting_paper_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "paper_id values from sources.json. Y1 enforces this join."
        }
      },
      "additionalProperties": false
    },
    "Gap": {
      "type": "object",
      "required": ["id", "type", "description", "priority_score"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G-[0-9]{2}$",
          "description": "Gap ID. Pattern G-NN."
        },
        "type": {
          "type": "string",
          "enum": ["empirical", "methodological", "theoretical", "temporal", "geographic", "population", "translational"]
        },
        "description": { "type": "string", "minLength": 1 },
        "priority_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Priority per agents/synthesis.md Step 5 scoring rubric."
        },
        "supporting_paper_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Optional. Papers that point to this gap (e.g. authors who explicitly note it)."
        }
      },
      "additionalProperties": false
    },
    "Contradiction": {
      "type": "object",
      "required": ["id", "claim_a", "claim_b", "paper_ids"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[0-9]{2}$"
        },
        "claim_a": { "type": "string", "minLength": 1 },
        "claim_b": { "type": "string", "minLength": 1 },
        "paper_ids": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 },
          "description": "paper_ids supporting the contradicting claims. Y2 enforces minItems >= 2."
        },
        "resolution_note": {
          "type": ["string", "null"],
          "description": "Synthesis-agent note on whether the contradiction is reconcilable (e.g. 'different populations', 'methodological divergence')."
        }
      },
      "additionalProperties": false
    },
    "DossierCrossRef": {
      "type": "object",
      "required": ["claim", "dossier_field", "dossier_value", "concordance"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "dossier_field": {
          "type": "string",
          "description": "e.g. 'string.score', 'gtex.tpm', 'opentargets.score'."
        },
        "dossier_value": { "type": ["string", "number", "null"] },
        "concordance": {
          "type": "string",
          "enum": ["concordant", "discordant", "complementary", "no_data"]
        },
        "paper_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "Hypothesis": {
      "type": "object",
      "required": ["id", "statement", "rationale", "supporting_paper_ids", "quality_score"],
      "properties": {
        "id": { "type": "string", "pattern": "^H-[0-9]{2}$" },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "supporting_paper_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "quality_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Per references/hypothesis_quality_criteria.md 10-point rubric."
        }
      },
      "additionalProperties": false
    }
  }
}
