{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "audit_report.json",
  "title": "AuditReport",
  "description": "Top-level report. Rendered to markdown by render_report.py. Validated end-to-end before delivery.",
  "type": "object",
  "required": ["header", "executive_summary", "findings", "verification_matrix", "methodology_note"],
  "properties": {
    "header": {
      "type": "object",
      "required": [
        "document_title",
        "document_type",
        "date_checked",
        "verification_tier",
        "sources_consulted",
        "overall_confidence",
        "confidence_justification",
        "coverage_caveats"
      ],
      "properties": {
        "document_title": { "type": "string", "minLength": 1 },
        "document_type": {
          "type": "string",
          "enum": ["grant", "manuscript", "lit_review", "slides", "report", "memo", "other"]
        },
        "date_checked": { "type": "string", "format": "date" },
        "verification_tier": {
          "type": "string",
          "enum": ["1", "2", "3", "custom"]
        },
        "sources_consulted": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Tools and resources actually queried during this audit."
        },
        "overall_confidence": {
          "type": "string",
          "enum": ["high", "moderate", "low", "very_low"],
          "description": "Computed: high = 0 CRITICAL, ≤1 MAJOR; moderate = ≤2 CRITICAL or ≤5 MAJOR; low = 3-5 CRITICAL; very_low = ≥6 CRITICAL or systemic hallucination."
        },
        "confidence_justification": { "type": "string", "minLength": 1 },
        "coverage_caveats": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Paywalled full texts, unavailable preprints, or any depth-tier checks that could not be completed."
        }
      },
      "additionalProperties": false
    },
    "executive_summary": {
      "type": "string",
      "minLength": 100,
      "description": "3-5 sentence prose summary covering total claims, severity counts, most consequential issues, overall recommendation."
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/Finding" }
    },
    "verification_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "verdict", "severity", "stage"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "verdict": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "METADATA_MISMATCH",
              "UNSUPPORTED",
              "OVERGENERALIZED",
              "CONTRADICTED",
              "MISATTRIBUTED",
              "QUOTE_VERIFIED",
              "QUOTE_PARAPHRASED",
              "QUOTE_FABRICATED",
              "UNVERIFIED"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "MAJOR", "MINOR", "INFORMATIONAL"]
          },
          "stage": {
            "type": "string",
            "enum": ["2", "3", "4", "5", "6", "7"]
          }
        },
        "additionalProperties": false
      },
      "description": "Complete claim-by-claim audit trail including unflagged items. Stage-8 self-audit verifies every ClaimInventory.id appears here or in findings[]."
    },
    "methodology_note": {
      "type": "string",
      "minLength": 1,
      "description": "Brief description of which sources were queried in what order, depth tier executed, and any limitations."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Finding": {
      "type": "object",
      "description": "Inlined from finding.json so audit_report.json validates without an external $ref resolver. Keep in sync with schemas/finding.json.",
      "required": [
        "id",
        "location",
        "claim_verbatim",
        "claim_type",
        "verification_path",
        "evidence",
        "verdict",
        "severity",
        "recommended_action",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "required": ["section", "paragraph"],
          "properties": {
            "section": { "type": "string", "minLength": 1 },
            "paragraph": { "type": "integer", "minimum": 1 },
            "line": { "type": ["integer", "null"], "minimum": 1 }
          },
          "additionalProperties": false
        },
        "claim_verbatim": { "type": "string", "minLength": 1 },
        "claim_type": {
          "type": "string",
          "enum": [
            "citation_bearing",
            "direct_quote",
            "numerical",
            "named_entity",
            "mechanistic",
            "attribution",
            "uncited"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "raw_text"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "doi": { "type": ["string", "null"] },
              "pmid": { "type": ["string", "null"] },
              "raw_text": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "verification_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["method", "tool", "result_summary"],
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "doi_lookup",
                  "pmid_lookup",
                  "crossref_search",
                  "pubmed_search",
                  "pmc_fetch",
                  "exact_quote_match",
                  "scite_context",
                  "web_search",
                  "abstract_check",
                  "ref_reconcile",
                  "acronym_scan",
                  "journal_volume_check",
                  "entity_resolve",
                  "pubtator3_entity_check"
                ]
              },
              "tool": { "type": "string", "minLength": 1 },
              "query": { "type": "string" },
              "result_summary": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source", "url"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 },
              "snippet": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "verdict": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "METADATA_MISMATCH",
            "UNSUPPORTED",
            "OVERGENERALIZED",
            "CONTRADICTED",
            "MISATTRIBUTED",
            "QUOTE_VERIFIED",
            "QUOTE_PARAPHRASED",
            "QUOTE_FABRICATED",
            "UNVERIFIED"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["CRITICAL", "MAJOR", "MINOR", "INFORMATIONAL"]
        },
        "recommended_action": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "reason": {
          "type": "string",
          "enum": [
            "paywalled_full_text",
            "preprint_not_indexed",
            "api_timeout",
            "source_not_provided",
            "tier_does_not_cover",
            "other"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
