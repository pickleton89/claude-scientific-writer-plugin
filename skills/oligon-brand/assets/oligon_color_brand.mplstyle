##############################################
# Oligon Brand Style v5.0 — Style Guide v2.3 #
##############################################
# Aligned with Oligon_Digital_Style_Guide_v2.3.html (April 2026):
# Oklch tonal ramps (Blue / Orange / Neutral × 10 steps), same-hue
# treatment/control cycle, neutral.200 axis furniture, figure type scale
# (title 12 pt / axis 10 pt / tick 9 pt / legend 8.5 pt).
# Most data should draw from the neutral or peer-blue ramp; Brand Blue
# (#2DB2E8) is reserved for 1–2 focal elements per panel.

##########
# Figure #
##########
figure.facecolor: white
figure.edgecolor: white
figure.dpi: 150
figure.constrained_layout.use: True

savefig.facecolor: white
savefig.edgecolor: white
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.1

##########
# Font   #
##########
font.family: sans-serif
font.sans-serif: Arial, Helvetica, DejaVu Sans
font.size: 9

########
# Axes #
########
axes.facecolor: white
axes.edgecolor: 121719
axes.linewidth: 0.8

# Figure Type Scale (v2.3)
axes.labelcolor: 121719
axes.labelsize: 10
axes.titlesize: 12
axes.titlecolor: 121719
axes.titleweight: bold

# Despined layout — top and right spines hidden
axes.spines.top: False
axes.spines.right: False
axes.spines.bottom: True
axes.spines.left: True

# Default color cycle: Cycle 1 — Treatment / Control (same-hue).
# Position 1 = brand.blue treatment, 2 = blue.300 control, 3 = blue.100 CI,
# with ramp steps trailing so n>3 still reads consistently.
# For other cycles call `set_brand_style('peer' | 'focus' | 'opposing'
# | 'multi_category')` from matplotlib_adapter.
axes.prop_cycle: cycler("color", ["2DB2E8", "76CAF3", "DBF3FF", "003454", "C45E39"])

###########
# Ticks   #
###########
xtick.color: 121719
ytick.color: 121719
xtick.labelsize: 9
ytick.labelsize: 9
xtick.direction: out
ytick.direction: out

###########
# Grid    #
###########
# Off by default; neutral.200 dashed 0.5 pt when enabled.
axes.grid: False
grid.color: D6DCDF
grid.linestyle: --
grid.linewidth: 0.5
grid.alpha: 1.0

#############
# Lines     #
#############
# v2.3: 1.8–2.2 pt primary data; 5–6 pt filled markers.
lines.linewidth: 2.0
lines.markersize: 5.5
lines.solid_capstyle: round

###########
# Patches #
###########
# Bars: no edge outlines (data-ink economy).
patch.facecolor: 2DB2E8
patch.edgecolor: none
patch.linewidth: 0.0

############
# Legend   #
############
legend.frameon: False
legend.facecolor: white
legend.edgecolor: none
legend.fontsize: 8.5
legend.title_fontsize: 9
legend.loc: best

##########
# Text   #
##########
text.color: 121719

##########
# Image  #
##########
# Default sequential colormap. For divergent data use
# matplotlib_adapter.get_divergent_cmap() (blue.700 → white → orange.700).
image.cmap: viridis
