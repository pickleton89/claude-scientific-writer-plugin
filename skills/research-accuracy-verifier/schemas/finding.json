{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finding.json",
  "title": "Finding",
  "description": "One verified or flagged claim with its full evidence trail. Validated by validate_finding.py against schema + predicates P1-P5 from CONTRACTS.md.",
  "type": "object",
  "required": [
    "id",
    "location",
    "claim_verbatim",
    "claim_type",
    "verification_path",
    "evidence",
    "verdict",
    "severity",
    "recommended_action",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Matches ClaimInventoryItem.id from Stage 1."
    },
    "location": {
      "type": "object",
      "required": ["section", "paragraph"],
      "properties": {
        "section": { "type": "string", "minLength": 1 },
        "paragraph": { "type": "integer", "minimum": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "claim_verbatim": {
      "type": "string",
      "minLength": 1,
      "description": "Exact wording from the document. P-violation if it does not string-equal the corresponding span in <document>."
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "citation_bearing",
        "direct_quote",
        "numerical",
        "named_entity",
        "mechanistic",
        "attribution",
        "uncited"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "raw_text"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "doi": { "type": ["string", "null"] },
          "pmid": { "type": ["string", "null"] },
          "raw_text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verification_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "tool", "result_summary"],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "doi_lookup",
              "pmid_lookup",
              "crossref_search",
              "pubmed_search",
              "pmc_fetch",
              "exact_quote_match",
              "scite_context",
              "web_search",
              "abstract_check",
              "ref_reconcile",
              "acronym_scan",
              "journal_volume_check",
              "entity_resolve"
            ]
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "description": "Tool / script name ('PubMed MCP', 'validate_citations.py', 'verify_exact_quote.py')."
          },
          "query": { "type": "string" },
          "result_summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "url"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Resolvable URL, DOI string, or PMID. P3 enforces presence; reachability check is a soft warning."
          },
          "snippet": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "METADATA_MISMATCH",
        "UNSUPPORTED",
        "OVERGENERALIZED",
        "CONTRADICTED",
        "MISATTRIBUTED",
        "QUOTE_VERIFIED",
        "QUOTE_PARAPHRASED",
        "QUOTE_FABRICATED",
        "UNVERIFIED"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "MAJOR", "MINOR", "INFORMATIONAL"],
      "description": "Computed by validate_finding.py via SeverityMatrix[document_type][verdict]. User-supplied values that disagree are rejected (P5)."
    },
    "recommended_action": { "type": "string", "minLength": 1 },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "reason": {
      "type": "string",
      "enum": [
        "paywalled_full_text",
        "preprint_not_indexed",
        "api_timeout",
        "source_not_provided",
        "tier_does_not_cover",
        "other"
      ],
      "description": "Required when verdict == UNVERIFIED. Business rule (P1) enforced in validate_finding.py."
    }
  },
  "additionalProperties": false
}
