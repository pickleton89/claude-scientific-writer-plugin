{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oligon.io/schemas/markdown-to-pdf/phase-plan",
  "title": "Phase Plan Frontmatter",
  "description": "Implementation phase planning - project-mgmt category",
  "type": "object",
  "allOf": [
    { "$ref": "_base.json" }
  ],
  "properties": {
    "type": {
      "const": "phase-plan"
    },
    "project": {
      "type": "string",
      "description": "Project name"
    },
    "phase": {
      "type": "string",
      "description": "Phase identifier (e.g., 'Phase 2', 'MVP')"
    },
    "owner": {
      "type": "string",
      "description": "Phase owner/lead"
    }
  },
  "required": ["type", "title", "date"],
  "required_sections": [
    "Objectives",
    "Timeline"
  ],
  "optional_sections": [
    "Resources",
    "Risks",
    "Dependencies"
  ],
  "pipeline": "markdown-only"
}
