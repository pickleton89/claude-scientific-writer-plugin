{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oligon.io/schemas/markdown-to-pdf/literature-review",
  "title": "Literature Review Frontmatter",
  "description": "Systematic literature review - scientific category",
  "type": "object",
  "allOf": [
    { "$ref": "_base.json" }
  ],
  "properties": {
    "type": {
      "const": "literature-review"
    },
    "topic": {
      "type": "string",
      "description": "Review topic or research question"
    },
    "scope": {
      "type": "string",
      "description": "Scope of the review (e.g., date range, databases)"
    }
  },
  "required": ["type", "title", "date"],
  "required_sections": [
    "Introduction",
    "Methods",
    "Results"
  ],
  "optional_sections": [
    "Discussion",
    "Conclusion",
    "References"
  ],
  "pipeline": "html-render"
}
